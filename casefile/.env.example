# Postgres connection string
DATABASE_URL="postgresql://casefile:casefile@localhost:5432/casefile?schema=public"
# Any long random string. Signs login sessions.
AUTH_SECRET="replace-with-a-long-random-string"
# From console.anthropic.com. Needed for the pre-publish check and draft script.
ANTHROPIC_API_KEY=""
# Optional: public URL used in sign-in links. Defaults to the request's host.
# APP_URL="https://casefile.example.com"
# Optional: where uploaded source files are saved. Defaults to ./uploads
# UPLOAD_DIR=""
